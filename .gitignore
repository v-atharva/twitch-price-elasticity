# data is rebuilt via make targets; only the curated reference tables are committed
data/*
!data/reference/

# outputs (figures + headline estimate files) are committed for the README

__pycache__/
*.pyc

# dot files/dirs (tool caches, editor state, OS cruft) are never tracked,
# except the repo essentials re-included below
.*
!.github/
!.gitignore
!.python-version

# documentation agent workspace
devdocs/
